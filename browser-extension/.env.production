# Production build: npm run build:prod / zip:prod (sideload test build) and
# npm run zip:store (store packages, no manifest key). -> .output/chrome-mv3
# No secrets here: URLs, the public OAuth client id and a public manifest key.
WXT_API_BASE_URL=https://app.hustlen.ai/server/api
WXT_APP_BASE_URL=https://app.hustlen.ai
WXT_OAUTH_CLIENT_ID=hustlen-extension
WXT_ENV_LABEL=
# Pins the sideloaded test build's id to cengnipjmfhjcdchinmldhpkibpahcki; the production
# backend allow-lists https://cengnipjmfhjcdchinmldhpkibpahcki.chromiumapp.org/. Dropped from
# store packages (zip:store): the store assigns its own id (see ENVIRONMENTS.md).
WXT_MANIFEST_
