{
  "name": "hustlen-browser-extension",
  "description": "hustlen.ai \u2013 autofill and track job applications from your Master CV",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:firefox:store": "WXT_STORE_BUILD=1 wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "build:stg": "wxt build --mode staging",
    "build:prod": "wxt build",
    "zip:stg": "wxt zip --mode staging && wxt zip -b edge --mode staging",
    "zip:prod": "wxt zip && wxt zip -b edge",
    "zip:store": "WXT_STORE_BUILD=1 wxt zip && WXT_STORE_BUILD=1 wxt zip -b edge && WXT_STORE_BUILD=1 wxt zip -b firefox --mv3",
    "submit:init": "wxt submit init",
    "submit": "wxt submit --chrome-api-version v2 --chrome-zip .output/*-chrome.zip --edge-zip .output/*-edge.zip --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.4",
    "@wxt-dev/auto-icons": "^1.1.2",
    "jsdom": "^30.1.1",
    "typescript": "~5.9",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
