# Staging build: npm run build:stg / zip:stg -> .output/chrome-mv3-staging
# No secrets here: URLs, the public OAuth client id and a public manifest key.
WXT_API_BASE_URL=https://devapp.hustlen.ai/server/api
WXT_APP_BASE_URL=https://devapp.hustlen.ai
WXT_OAUTH_CLIENT_ID=hustlen-extension
# Shown in the extension name ("hustlen.ai STG") so it can't be mistaken for production.
WXT_ENV_LABEL=STG
# Pins the extension id to efnmckkaaknobocjdmmioepejamcmpap; the staging backend allow-lists
# https://efnmckkaaknobocjdmmioepejamcmpap.chromiumapp.org/ (see ENVIRONMENTS.md).
WXT_MANIFEST_
