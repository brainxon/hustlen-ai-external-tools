# Copy to .env for local development (staging/production: .env.staging /
# .env.production, committed - see ENVIRONMENTS.md). WXT exposes WXT_* vars
# as import.meta.env.WXT_*.
WXT_API_BASE_URL=http://localhost:5004/api
WXT_APP_BASE_URL=http://localhost:4300
WXT_OAUTH_CLIENT_ID=hustlen-extension
# Optional: base64 public key to pin the extension id in dev builds.
WXT_MANIFEST_KEY=
